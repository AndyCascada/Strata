generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Headline {
  id           String   @id @default(cuid())
  headline     String
  source       String
  url          String   @unique
  publishedAt  String
  category     String   @default("general")

  recentScore    String
  recentSummary  String
  recentDetail   String

  broadScore     String
  broadSummary   String
  broadDetail    String

  humanScore     String
  humanSummary   String
  humanDetail    String

  isPolitical        Boolean @default(false)
  politicianName     String?
  partyName          String?

  campaignScore    String?
  campaignSummary  String?
  campaignDetail   String?

  partyScore    String?
  partySummary  String?
  partyDetail   String?

  analyzedAt   DateTime @default(now())
  forDate      String

  @@index([forDate])
}
